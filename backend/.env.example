# ─────────────────────────────────────────────────────────────
# CertiVault backend configuration
# Copy to `.env` and fill in values.  NEVER commit `.env`.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
# Bind to localhost only. On EC2, Nginx (port 80) proxies to this port,
# so port 4000 is never exposed to the internet.
HOST=127.0.0.1
PORT=4000

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=8h

# SQLite database file (metadata only; PDFs are never stored here)
DATABASE_PATH=./database/certivault.db

# Public URL of the website. Used to build verification links and QR codes.
#   Local dev:  http://localhost:5173
#   EC2:        http://<your-elastic-ip-or-domain>
PUBLIC_APP_URL=http://localhost:5173

# Comma-separated list of browser origins allowed to call the API (dev only;
# in production the frontend and API share one origin through Nginx).
CORS_ORIGINS=http://localhost:5173

# Set to true when running behind Nginx so rate limiting sees real client IPs.
TRUST_PROXY=false

# ── Storage ──────────────────────────────────────────────────
# s3    = Amazon S3 (the real cloud storage used for the project)
# local = DEVELOPMENT-ONLY disk storage in LOCAL_STORAGE_DIR. This is NOT AWS.
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage

# Required when STORAGE_DRIVER=s3
AWS_REGION=ap-south-1
S3_BUCKET_NAME=

# Do NOT put AWS access keys here.
# On EC2 the AWS SDK picks up temporary credentials from the attached IAM role.
# On your laptop (optional S3 testing) use `aws configure --profile certivault`
# and set AWS_PROFILE=certivault in your shell instead.

# ── Limits ───────────────────────────────────────────────────
MAX_UPLOAD_MB=5
PRESIGNED_URL_TTL_SECONDS=300
